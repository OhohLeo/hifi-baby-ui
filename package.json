{
  "name": "hifi-baby-ui",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "vue-tsc --noEmit && vite build",
    "build:android": "npm run build:web && npx cap sync android && npx cap open android",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "knip": "knip",
    "dead-code": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run lint:check && npm run type-check && npm run test",
    "cap:sync": "npx cap sync",
    "cap:sync:android": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:run:android": "npx cap run android",
    "build:android:apk": "npm run build:web && npx cap sync android && cd android && ./gradlew build && cd ..",
    "deploy:android:apk": "/home/lmartin/Android/Sdk/platform-tools/adb devices && /home/lmartin/Android/Sdk/platform-tools/adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "build-deploy:android:apk": "npm run build:android:apk && npm run deploy:android:apk"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.1.3",
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capawesome/capacitor-file-picker": "^8.0.2",
    "@mdi/font": "7.4.47",
    "axios": "^1.14.0",
    "vue": "^3.5.31",
    "vue-i18n": "^11.3.0",
    "vuetify": "^4.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/eslint-config-typescript": "^14.7.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-vuetify": "^4.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "knip": "^6.1.0",
    "pinia": "^3.0.4",
    "sass": "1.98.0",
    "terser": "^5.46.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.0.16",
    "jsdom": "^27.4.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^32.0.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^8.0.3",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-router": "^5.0.4",
    "vue-tsc": "^3.2.6"
  }
}
